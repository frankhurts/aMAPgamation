# Copy to .env (gitignored) and fill in. Nothing here is required for Phase 1.
PORT=8787
DATA_DIR=./data

# Phase 2 only — Google Places API (New) key, used to hydrate Takeout exports
# of your saved places. Restrict it to the Places API in Google Cloud Console.
# GOOGLE_PLACES_API_KEY=

# Google Maps Platform key for scripts/routes2gpx.sh, which turns the Google
# Maps directions URLs in route-urls.txt into GPX. Restrict it to the
# Directions API (plus Geocoding if you use -m motorcycle).
# GOOGLE_MAPS_API_KEY=
