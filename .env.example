# Copy to .env (gitignored) and fill in. Nothing here is required for Phase 1.
PORT=8787
DATA_DIR=./data

# Phase 2 only — Google Places API (New) key, used to hydrate Takeout exports
# of your saved places. Restrict it to the Places API in Google Cloud Console.
# GOOGLE_PLACES_API_KEY=

# Google Maps Platform key for scripts/routes2gpx.sh, which turns the Google
# Maps directions URLs in route-urls.txt into GPX. Restrict it to the
# Directions API (plus Geocoding if you use -m motorcycle).
# GOOGLE_MAPS_API_KEY=

# Optional — recreation.gov (RIDB), used by a "corridor" source when you list
# "ridb" in its providers. Free key from https://ridb.recreation.gov/profile.
# Without it, BLM and OpenStreetMap still work; the sync just says RIDB was
# skipped. A missing key and a wrong key both come back as the same 401.
# RIDB_API_KEY=

# Corridor fetch tuning. All optional.
# CORRIDOR_NO_CACHE=1            # bypass the on-disk response cache
# CORRIDOR_CACHE_TTL_MS=604800000  # how long cached responses live (7 days)
# CORRIDOR_TIMEOUT_MS=120000     # per-request timeout
# CORRIDOR_USER_AGENT=           # how this tool identifies itself to the APIs
# OVERPASS_URL=                  # a different Overpass instance to try first
