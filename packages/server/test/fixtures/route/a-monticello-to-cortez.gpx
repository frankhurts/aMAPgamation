<?xml version="1.0" encoding="UTF-8"?>
<!-- Second leg of the trip, but first alphabetically: chaining must reorder it.
     Attributes are lon-first with single quotes, as some exporters write them. -->
<gpx version="1.1" creator="fixture" xmlns="http://www.topografix.com/GPX/1/1">
  <wpt lat="37.3486" lon="-108.5859"><name>Cortez</name></wpt>
  <trk>
    <name>Monticello to Cortez</name>
    <trkseg>
      <trkpt lon='-109.3424' lat='37.8714'/>
      <trkpt lon='-109.1500' lat='37.7000'/>
      <trkpt lon='-108.9000' lat='37.5200'/>
      <trkpt lon='-108.5859' lat='37.3486'/>
    </trkseg>
  </trk>
</gpx>
